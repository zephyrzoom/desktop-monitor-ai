{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Tauri Dev (渲染进程调试)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/src/renderer",
      "presentation": {
        "hidden": true
      }
    },
    {
      "name": "Tauri Dev (Rust 调试, 需 CodeLLDB)",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["build", "--manifest-path=./src-tauri/Cargo.toml"],
        "cwd": "${workspaceFolder}"
      },
      "env": {
        "RUST_BACKTRACE": "1"
      }
    }
  ]
}
