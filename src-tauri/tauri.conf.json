{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Desktop Monitor",
  "version": "1.0.0",
  "identifier": "com.desktop-monitor.app",
  "mainBinaryName": "desktop-monitor",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist-renderer"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Desktop Monitor",
        "width": 1000,
        "height": 700,
        "minWidth": 820,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "visible": true,
        "backgroundColor": "#0f1115"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
