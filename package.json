{
  "name": "desktop-monitor",
  "version": "1.0.0",
  "description": "Desktop monitoring system with AI-powered work analysis",
  "author": "example.com",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck": "tsc --noEmit -p tsconfig.web.json",
    "dev": "tauri dev",
    "dev:web": "vite",
    "build:web": "vite build",
    "build": "npm run typecheck && tauri build",
    "build:win": "tauri build --bundles nsis",
    "build:linux": "tauri build --bundles deb",
    "rust:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-router-dom": "^7.15.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tauri-apps/cli": "^2.9.0",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.2",
    "vite": "^7.2.6"
  }
}
